# Copy to docker/.env and adjust. Every value below is also the built-in default used when .env is absent.
# These are LOCAL DEVELOPMENT credentials only.

# Host interface for published ports (use 0.0.0.0 to expose to the network)
BIND_ADDRESS=127.0.0.1

# --- RabbitMQ ---
RABBITMQ_IMAGE=docker.io/library/rabbitmq:4.2.7-management-alpine
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=admin
RABBITMQ_EMF_USER=emf
RABBITMQ_EMF_PASSWORD=emf

# --- Elasticsearch (8.x to match the elasticsearch==8.15 python client) ---
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.25
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HEAP=512m
# At least 6 characters (Elasticsearch minimum), also for KIBANA_SYSTEM_PASSWORD
ELASTIC_PASSWORD=elastic
ELASTICSEARCH_API_KEY_NAME=emf-local

# --- Kibana (same version as Elasticsearch) ---
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.19.25
KIBANA_PORT=5601
# Password of the built-in kibana_system user that Kibana uses to connect to Elasticsearch
KIBANA_SYSTEM_PASSWORD=kibana
# At least 32 characters; keep stable, changing it invalidates sessions and encrypted saved objects
KIBANA_ENCRYPTION_KEY=emf-local-kibana-encryption-key-0001

# --- MinIO ---
# Official community images are no longer published; pin a digest for reproducibility, e.g.
# MINIO_IMAGE=docker.io/chainguard/minio@sha256:<digest>
MINIO_IMAGE=docker.io/chainguard/minio:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Passwords need at least 8 characters (MinIO minimum)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_EMF_USER=emf
MINIO_EMF_PASSWORD=password

# --- EMF services (compose.services.yaml) ---
MODEL_RETRIEVER_IMAGE=docker.io/balticrcc/emfos-model-retriever:latest
MODEL_VALIDATOR_IMAGE=docker.io/balticrcc/emfos-model-validator:latest
MODEL_MERGER_IMAGE=docker.io/balticrcc/emfos-model-merger:latest
